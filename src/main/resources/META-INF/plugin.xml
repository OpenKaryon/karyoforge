<idea-plugin>
    <id>org.openkaryon.karyoforge</id>
    <name>KaryoForge</name>
    <vendor url="https://github.com/OpenKaryon">OpenKaryon</vendor>
    <description><![CDATA[
        <p>KaryoForge is an OpenKaryon workbench built on IntelliJ IDEA Community.</p>
        <p>Native Python editing, script and module execution, unittest/pytest
        configurations and debugging use the pinned Python Community provider.
        Explicit interpreter selection is scoped to the active file's module.</p>
        <p>Reversible spell-checking preferences preserve existing inspection
        profiles and leave code and error diagnostics unchanged.</p>
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>PythonCore</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>org.toml.lang</depends>
    <depends>org.jetbrains.plugins.terminal</depends>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="KaryoForge Databases" anchor="bottom" factoryClass="org.openkaryon.karyoforge.database.ui.DatabasesToolWindowFactory"/>
        <fileType name="KaryoForge SQL" language="KaryoForgeSQL" extensions="sql"
                  implementationClass="org.openkaryon.karyoforge.database.sql.DatabaseSqlFileType" fieldName="INSTANCE"/>
        <lang.parserDefinition language="KaryoForgeSQL"
                               implementationClass="org.openkaryon.karyoforge.database.sql.DatabaseSqlParser"/>
        <lang.syntaxHighlighterFactory language="KaryoForgeSQL"
                                       implementationClass="org.openkaryon.karyoforge.database.sql.DatabaseSqlHighlighter"/>
        <completion.contributor language="KaryoForgeSQL"
                                implementationClass="org.openkaryon.karyoforge.database.sql.DatabaseSqlCompletion"/>
        <gotoDeclarationHandler implementation="org.openkaryon.karyoforge.database.sql.DatabaseSqlDeclaration"/>
        <editorFactoryListener implementation="org.openkaryon.karyoforge.database.sql.DatabaseSqlEditorShortcuts"/>
        <fileTypeOverrider implementation="org.openkaryon.karyoforge.biology.preview.BiologyPreviewProvider$TextType"/>
        <fileEditorProvider implementation="org.openkaryon.karyoforge.biology.preview.BiologyPreviewProvider"/>
        <fileTypeOverrider implementation="org.openkaryon.karyoforge.data.preview.DelimitedPreviewProvider$TextType"/>
        <fileEditorProvider implementation="org.openkaryon.karyoforge.data.preview.DelimitedPreviewProvider"/>
        <fileTypeOverrider implementation="org.openkaryon.karyoforge.notebook.editor.NotebookJsonType" order="first"/>
        <fileEditorProvider implementation="org.openkaryon.karyoforge.notebook.editor.NotebookEditorProvider" order="first"/>
        <applicationConfigurable parentId="tools" id="org.openkaryon.karyoforge.settings"
                                 displayName="KaryoForge"
                                 instance="org.openkaryon.karyoforge.settings.EditingSettingsConfigurable"/>
        <lang.inspectionSuppressor language=""
                                  implementationClass="org.openkaryon.karyoforge.settings.SpellingInspectionSuppressor"/>
        <editorNotificationProvider implementation="org.openkaryon.karyoforge.languages.python.PythonInterpreterNotification"/>
        <lang.inspectionSuppressor language="Python"
                                  implementationClass="org.openkaryon.karyoforge.languages.python.MissingPythonInterpreterSuppressor"/>
    </extensions>
    <actions>
        <action id="org.openkaryon.karyoforge.database.runSql" text="Run SQL Selection / Current Statement"
                description="Run the selected SQL or statement at the caret on the database connection"
                class="org.openkaryon.karyoforge.database.sql.RunDatabaseSqlAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <group id="org.openkaryon.karyoforge.tools" text="KaryoForge" popup="true">
            <action id="org.openkaryon.karyoforge.notebook.new" text="New Jupyter Notebook..."
                    description="Create a local notebook without starting a Python runtime"
                    class="org.openkaryon.karyoforge.notebook.editor.NewNotebookAction"/>
            <action id="org.openkaryon.karyoforge.python.chooseInterpreter" text="Choose Python Interpreter..."
                    description="Choose the interpreter for the module owning the active Python file"
                    class="org.openkaryon.karyoforge.languages.python.ChoosePythonInterpreterAction"/>
            <action id="org.openkaryon.karyoforge.python.useProjectEnvironment" text="Use Project Python Environment..."
                    description="Choose an existing local virtual environment for a module"
                    class="org.openkaryon.karyoforge.languages.python.UseProjectPythonEnvironmentAction"/>
            <action id="org.openkaryon.karyoforge.python.createEnvironment" text="Create Python Environment..."
                    description="Create a local virtual environment and assign it to a module"
                    class="org.openkaryon.karyoforge.languages.python.CreatePythonEnvironmentAction"/>
            <action id="org.openkaryon.karyoforge.python.installRequirements" text="Install Python Requirements..."
                    description="Install an explicitly chosen requirements file into the module virtual environment"
                    class="org.openkaryon.karyoforge.languages.python.InstallPythonRequirementsAction"/>
            <action id="org.openkaryon.karyoforge.python.installProject" text="Install Python Project..."
                    description="Install a standard Python project with optional editable mode and chosen extras"
                    class="org.openkaryon.karyoforge.languages.python.InstallPythonProjectAction"/>
            <action id="org.openkaryon.karyoforge.python.openConsole" text="Open Module Python Console"
                    description="Start a new native Python console with the selected module interpreter"
                    class="org.openkaryon.karyoforge.languages.python.OpenModulePythonConsoleAction"/>
            <action id="org.openkaryon.karyoforge.python.openTerminal" text="Open Module Python Terminal"
                    description="Start a new native terminal in the selected module with provider environment activation"
                    class="org.openkaryon.karyoforge.languages.python.OpenModulePythonTerminalAction"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
