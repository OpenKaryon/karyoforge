<idea-plugin>
    <id>org.openkaryon.karyoforge</id>
    <name>KaryoForge</name>
    <vendor url="https://github.com/OpenKaryon">OpenKaryon</vendor>
    <description><![CDATA[
        <p>KaryoForge is an OpenKaryon workbench built on IntelliJ IDEA Community.</p>
        <p>Native Python editing, script and module execution, unittest/pytest
        configurations and debugging use the pinned Python Community provider.
        Explicit interpreter selection is scoped to the active file's module.</p>
        <p>Reversible spell-checking preferences preserve existing inspection
        profiles and leave code and error diagnostics unchanged.</p>
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>PythonCore</depends>
    <depends>org.toml.lang</depends>
    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable parentId="tools" id="org.openkaryon.karyoforge.settings"
                                 displayName="KaryoForge"
                                 instance="org.openkaryon.karyoforge.settings.EditingSettingsConfigurable"/>
        <lang.inspectionSuppressor language=""
                                  implementationClass="org.openkaryon.karyoforge.settings.SpellingInspectionSuppressor"/>
        <editorNotificationProvider implementation="org.openkaryon.karyoforge.languages.python.PythonInterpreterNotification"/>
        <lang.inspectionSuppressor language="Python"
                                  implementationClass="org.openkaryon.karyoforge.languages.python.MissingPythonInterpreterSuppressor"/>
    </extensions>
    <actions>
        <group id="org.openkaryon.karyoforge.tools" text="KaryoForge" popup="true">
            <action id="org.openkaryon.karyoforge.python.chooseInterpreter" text="Choose Python Interpreter..."
                    description="Choose the interpreter for the module owning the active Python file"
                    class="org.openkaryon.karyoforge.languages.python.ChoosePythonInterpreterAction"/>
            <action id="org.openkaryon.karyoforge.python.useProjectEnvironment" text="Use Project Python Environment..."
                    description="Choose an existing local virtual environment for a module"
                    class="org.openkaryon.karyoforge.languages.python.UseProjectPythonEnvironmentAction"/>
            <action id="org.openkaryon.karyoforge.python.createEnvironment" text="Create Python Environment..."
                    description="Create a local virtual environment and assign it to a module"
                    class="org.openkaryon.karyoforge.languages.python.CreatePythonEnvironmentAction"/>
            <action id="org.openkaryon.karyoforge.python.installRequirements" text="Install Python Requirements..."
                    description="Install an explicitly chosen requirements file into the module virtual environment"
                    class="org.openkaryon.karyoforge.languages.python.InstallPythonRequirementsAction"/>
            <action id="org.openkaryon.karyoforge.python.installProject" text="Install Python Project..."
                    description="Install a standard Python project with optional editable mode and chosen extras"
                    class="org.openkaryon.karyoforge.languages.python.InstallPythonProjectAction"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
